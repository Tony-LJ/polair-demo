# #######################
# descri: Vue 项目「开发环境」的专属配置文件，
# 核心作用有 3 个：
# 1.集中管理开发环境的配置项：把开发时需要的端口、接口地址、功能开关等配置集中放在这里，不用散落在代码里（比如硬编码 3000 端口、/api 前缀）
# 2.区分环境：和生产环境（.env.production）、测试环境（.env.test）隔离，比如开发环境连本地 Mock 接口，生产环境连真实后端接口，改配置不用改代码
# author: Tony
# date: 2025-12-08
# #######################
VITE_API_BASE_URL= # 留空，不要配置成 http://127.0.0.1:8089
VITE_REQUEST_TIMEOUT=5000